// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Player {
  id            Int       @id @default(autoincrement())
  name          String
  position      Position
  nationality   String?
  age           Int
  overall       Int        @db.TinyInt     // 能力値 (0-100 想定)
  potential     Int        @db.TinyInt     // 伸びしろ (0-100 想定)
  currentClub   String?
  contractUntil DateTime?
  marketValue   Int?       // 移籍市場価値
  wage          Int?       // 年俸 / 週給
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  contracts     Contract[]

  @@index([name])
  @@index([position])
  @@index([overall])
}

enum Position {
  GK
  RB
  RWB
  CB
  LB
  LWB
  DM
  CM
  AM
  RW
  LW
  ST
  CF
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  country    String?
  foundedYear Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  contracts  Contract[]

  @@index([name])
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contracts Contract[]

  @@index([name])
}

model Contract {
  id        Int      @id @default(autoincrement())
  userId    Int
  playerId  Int
  teamId    Int
  startDate DateTime
  endDate   DateTime
  wage      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  @@index([userId])
  @@index([playerId])
  @@index([teamId])
  @@index([startDate])
}


