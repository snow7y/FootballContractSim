// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Player {
  id            Int       @id @default(autoincrement())
  name          String
  position      Position
  nationality   String?
  age           Int
  overall       Int        @db.TinyInt     // 能力値 (0-100 想定)
  potential     Int        @db.TinyInt     // 伸びしろ (0-100 想定)
  currentClub   String?
  contractUntil DateTime?
  marketValue   Int?       // 移籍市場価値
  wage          Int?       // 年俸 / 週給
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  contracts     Contract[]

  @@index([name])
  @@index([position])
  @@index([overall])
}

enum Position {
  GK
  RB
  RWB
  CB
  LB
  LWB
  DM
  CM
  AM
  RW
  LW
  ST
  CF
}

enum PhaseStatus {
  NotStarted
  InProgress
  Completed
}

enum GoalStatus {
  Active
  Completed
  Expired
  Disabled
}

enum ActionStatus {
  Success
  Failure
  Pending
}

enum ActionType {
  ContractCreated
  UserSelected
  UserCreated
  ContractFailed
  PhaseUpdated
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  country    String?
  foundedYear Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  contracts  Contract[]

  @@index([name])
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contracts       Contract[]
  phaseStates     GameplayPhaseState[]
  goals           Goal[]
  actionLogs      ActionLog[]
  scoreSnapshots  ScoreSnapshot[]

  @@index([name])
}

model Contract {
  id        Int      @id @default(autoincrement())
  userId    Int
  playerId  Int
  teamId    Int
  startDate DateTime
  endDate   DateTime
  wage      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])
  scoreSnapshots ScoreSnapshot[]

  @@index([userId])
  @@index([playerId])
  @@index([teamId])
  @@index([startDate])
}

model GameplayPhaseState {
  id         Int         @id @default(autoincrement())
  userId     Int
  phaseId    String
  phaseLabel String
  stepIndex  Int
  totalSteps Int
  status     PhaseStatus
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, phaseId])
  @@index([userId])
  @@index([status])
}

model Goal {
  id            Int        @id @default(autoincrement())
  userId        Int
  title         String
  description   String?
  status        GoalStatus
  reason        String?
  progressLabel String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model ActionLog {
  id              Int          @id @default(autoincrement())
  userId          Int
  actionType      ActionType
  status          ActionStatus
  message         String
  hint            String?
  deltaHighlights Json?
  occurredAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([occurredAt])
}

model ScoreSnapshot {
  id           Int          @id @default(autoincrement())
  userId       Int
  contractId   Int?
  totalScore   Int
  calculatedAt DateTime     @default(now())
  metrics      ScoreMetric[]

  user     User      @relation(fields: [userId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  @@index([userId])
  @@index([calculatedAt])
}

model ScoreMetric {
  id            Int      @id @default(autoincrement())
  snapshotId    Int
  label         String
  value         Int
  maxValue      Int?
  delta         Int?
  description   String?
  missingReason String?

  snapshot ScoreSnapshot @relation(fields: [snapshotId], references: [id])

  @@index([snapshotId])
}


